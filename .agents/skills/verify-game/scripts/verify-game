#!/usr/bin/env python3
import argparse
import hashlib
from itertools import zip_longest
import json
import math
import os
from pathlib import Path
import select
import shutil
import subprocess
import tempfile
import time

ROOT = Path(__file__).resolve().parents[4]
TARGET = ROOT / "target/verify-game"
BINARY = TARGET / "debug/cli"
ARTIFACTS = ROOT / ".amp/in/artifacts/game-verification"
MAX_RESPONSE_BYTES = 272 * 1024 * 1024
BUTTONS = (
    "move_up", "move_down", "move_left", "move_right",
    "action_up", "action_down", "action_left", "action_right",
    "left_shoulder", "right_shoulder", "back", "start",
)


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def integers(values, count, low, high):
    return isinstance(values, list) and len(values) == count and all(
        type(value) is int and low <= value <= high for value in values)


def validate(response, request=None):
    require(isinstance(response, dict), "response must be an object")
    if request is None:
        require(set(response) == {"uploads"}, "expected startup uploads")
        validate_uploads(response["uploads"])
    elif "audio" in request:
        audio = request["audio"]
        require(set(response) == {"sample_rate", "frames"} and
                response["sample_rate"] == audio["sample_rate"] and
                isinstance(response["frames"], list) and len(response["frames"]) == audio["frames"] and
                all(integers(frame, 2, -32768, 32767) for frame in response["frames"]),
                "incorrect audio rate, stereo count, or i16 samples")
    else:
        require({"canvas", "clear", "commands"} <= set(response) <=
                {"canvas", "clear", "commands", "uploads", "releases"}, "expected frame envelope")
        validate_uploads(response.get("uploads", []))
        releases = response.get("releases", [])
        require(isinstance(releases, list) and len(releases) <= 64 and
                all(type(value) is int and 0 <= value < 64 for value in releases),
                "invalid texture releases")
        require(isinstance(response["canvas"], list) and len(response["canvas"]) == 2 and
                all(type(value) in (int, float) and math.isfinite(value) and value > 0
                    for value in response["canvas"]), "invalid canvas")
        require(isinstance(response["clear"], list) and len(response["clear"]) == 4 and
                all(type(value) in (int, float) and 0 <= value <= 1
                    for value in response["clear"]), "invalid clear color")
        require(isinstance(response["commands"], list) and len(response["commands"]) <= 16384 and
                all(isinstance(command, dict) and command.get("type") in (
                    "set_camera", "set_clip", "draw_rect", "draw_line", "draw_quads"
                ) for command in response["commands"]), "invalid command list or tag")


def validate_uploads(uploads):
    require(isinstance(uploads, list) and len(uploads) <= 64, "invalid upload list")
    total = 0
    for upload in uploads:
        require(isinstance(upload, dict) and set(upload) == {"id", "image"} and
                integers([upload["id"]], 1, 0, 63), "invalid upload slot")
        image = upload["image"]
        require(isinstance(image, dict) and set(image) == {"width", "height", "rgba"} and
                integers([image["width"], image["height"]], 2, 1, 2048), "invalid image size")
        size = image["width"] * image["height"] * 4
        require(integers(image["rgba"], size, 0, 255), "invalid RGBA payload")
        total += size
    require(total <= 64 * 1024 * 1024, "texture budget exceeded")


def read_line(process, evidence):
    line = bytearray()
    deadline = time.monotonic() + 15
    while len(line) <= MAX_RESPONSE_BYTES:
        remaining = deadline - time.monotonic()
        require(remaining > 0 and select.select([process.stdout], [], [], remaining)[0],
                "CLI did not flush a response within 15 seconds")
        chunk = os.read(process.stdout.fileno(), min(65536, MAX_RESPONSE_BYTES + 1 - len(line)))
        evidence.write(chunk)
        evidence.flush()
        require(chunk, "CLI exited before a complete response")
        line.extend(chunk)
        require(len(line) <= MAX_RESPONSE_BYTES, "CLI response exceeds 272 MiB")
        if line.endswith(b"\n"):
            return json.loads(line)
    raise RuntimeError("CLI response exceeds 272 MiB")


def session(directory, name, inputs, options, expected_error=None):
    environment = os.environ.copy()
    for key in ("DISPLAY", "WAYLAND_DISPLAY"):
        environment.pop(key, None)
    with (directory / f"{name}-input.jsonl").open("wb") as sent, \
         (directory / f"{name}-output.jsonl").open("wb") as received, \
         (directory / f"{name}-stderr.txt").open("wb") as errors:
        process = subprocess.Popen(options.cli, cwd=options.cwd, env=environment,
                                   stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors)
        try:
            validate(read_line(process, received))
            print(f"healthy: {name}, initialization received without a display")
            require(not select.select([process.stdout], [], [], 0.02)[0],
                    "CLI produced output or exited before input")
            for record in inputs:
                sent.write(record)
                sent.flush()
                process.stdin.write(record)
                process.stdin.flush()
                if not expected_error:
                    if not record.endswith(b"\n"):
                        process.stdin.close()
                    validate(read_line(process, received), json.loads(record))
            if not expected_error and not process.stdin.closed:
                process.stdin.close()
            deadline = time.monotonic() + 15
            extra = 0
            while True:
                remaining = deadline - time.monotonic()
                require(remaining > 0 and select.select([process.stdout], [], [], remaining)[0],
                        "CLI did not terminate within 15 seconds")
                chunk = os.read(process.stdout.fileno(), 65536)
                received.write(chunk)
                received.flush()
                extra += len(chunk)
                require(extra <= MAX_RESPONSE_BYTES, "excess output after last response")
                if not chunk:
                    break
            status = process.wait(timeout=max(0.01, deadline - time.monotonic()))
            require(extra == 0, "unexpected output after last response")
            require(status == (1 if expected_error else 0), f"unexpected exit status: {status}")
        finally:
            if process.poll() is None:
                process.kill()
            status = process.wait(timeout=5)
            (directory / f"{name}-status.txt").write_text(f"{status}\n")
            process.stdout.close()
            if not process.stdin.closed:
                process.stdin.close()
    error_text = (directory / f"{name}-stderr.txt").read_text()
    require(expected_error in error_text if expected_error else not error_text,
            f"unexpected diagnostic: {error_text}")
    with (directory / f"{name}-output.jsonl").open("rb") as output:
        return hashlib.file_digest(output, "sha256").digest()


def encoded(value):
    return (json.dumps(value, separators=(",", ":")) + "\n").encode()


def frame(controller=None, secs=0, nanos=16666667):
    return {"dt": {"secs": secs, "nanos": nanos}, "controller": controller or {}}


def requests():
    for secs, nanos in ((0, 0), (0, 16666667), (18446744073709551615, 999999999)):
        yield encoded(frame(secs=secs, nanos=nanos))
    for name in BUTTONS:
        for ended, transitions in (("down", 1), ("down", 0), ("up", 1), ("up", 2), ("down", 4294967295)):
            yield encoded(frame({name: {"ended": ended, "half_transitions": transitions}}))
    yield encoded(frame())
    for rate, count in ((1, 0), (1, 1), (44100, 3), (192000, 16384), (48000, 4096), (48000, 4096)):
        yield encoded({"audio": {"sample_rate": rate, "frames": count}})
    yield encoded(frame(nanos=0))


def protocol(directory, options):
    for name, request, error in (
        ("missing", {}, "missing field dt"),
        ("null", frame() | {"controller": None}, "invalid type"),
        ("unknown", frame() | {"unknown": 0}, "unknown field"),
        ("button", frame({"start": {"ended": "pressed", "half_transitions": 1}}), "unknown variant"),
        ("transitions", frame({"start": {"ended": "down", "half_transitions": 4294967296}}), "invalid value"),
        ("duration", frame(nanos=1000000000), "dt.nanos must be less than 1000000000"),
        ("rate-low", {"audio": {"sample_rate": 0, "frames": 0}}, "audio.sample_rate must be between"),
        ("rate-high", {"audio": {"sample_rate": 192001, "frames": 0}}, "audio.sample_rate must be between"),
        ("audio-size", {"audio": {"sample_rate": 48000, "frames": 16385}}, "audio.frames exceeds"),
        ("mixed", frame() | {"audio": {"sample_rate": 1, "frames": 0}}, "audio cannot be combined"),
    ):
        session(directory, name, [encoded(request)], options, error)
    request = encoded({"audio": {"sample_rate": 1, "frames": 0}}).rstrip(b"\n")
    at_limit = request + b" " * (16384 - len(request) - 1) + b"\n"
    session(directory, "at-limit", [at_limit, request], options)
    session(directory, "oversized", [at_limit[:-1] + b" \n"], options, "input line exceeds 16384 bytes")
    session(directory, "no-newline", [at_limit[:-1] + b"  "], options, "input line exceeds 16384 bytes")
    session(directory, "stop-on-error", [b"{}\n" + request + b"\n"], options, "missing field dt")
    session(directory, "eof", [], options)


def main():
    parser = argparse.ArgumentParser(description="Verify the production CLI contract; never launches a graphical host.")
    parser.add_argument("command", choices=("launch", "doctor", "drive", "cleanup"))
    parser.add_argument("--inputs", type=Path, help="valid JSONL requests instead of the protocol baseline")
    parser.add_argument("--expected", type=Path, help="independently justified complete output JSONL, including startup")
    parser.add_argument("--cwd", type=Path, default=ROOT, help="game asset root")
    parser.add_argument("--persistent-bytes", type=int)
    parser.add_argument("--transient-bytes", type=int)
    options = parser.parse_args()
    if (options.inputs or options.expected) and options.command != "drive":
        parser.error("--inputs and --expected require drive")
    if options.expected and not options.inputs:
        parser.error("--expected requires --inputs")
    if options.command == "launch":
        subprocess.run(["cargo", "build", "--locked", "-p", "platform-linux", "--no-default-features",
                        "--features", "cli", "--bin", "cli", "--target-dir", str(TARGET)],
                       cwd=ROOT, check=True, timeout=600)
        print(f"ready: {BINARY}")
        return
    if options.command == "cleanup":
        print("clean: each session reaps its process; evidence is retained")
        return
    options.cli = [str(BINARY)]
    for flag, value in (("--persistent-bytes", options.persistent_bytes), ("--transient-bytes", options.transient_bytes)):
        if value is not None:
            options.cli.extend([flag, str(value)])
    ARTIFACTS.mkdir(parents=True, exist_ok=True)
    directory = Path(tempfile.mkdtemp(prefix="run-", dir=ARTIFACTS))
    print(f"evidence: {directory}", flush=True)
    with BINARY.open("rb") as binary:
        digest = hashlib.file_digest(binary, "sha256").hexdigest()
    (directory / "run.json").write_text(json.dumps({"command": options.cli, "cwd": str(options.cwd.resolve()),
                                                  "binary_sha256": digest}, indent=2) + "\n")
    if options.command == "doctor":
        session(directory, "doctor", [], options)
        return
    if options.inputs:
        with options.inputs.open("rb") as inputs:
            first = session(directory, "drive", inputs, options)
    else:
        first = session(directory, "drive", requests(), options)
    with (directory / "drive-input.jsonl").open("rb") as inputs:
        replay = session(directory, "replay", inputs, options)
    repeatability = "identical" if first == replay else "different; inspect external inputs and game behavior"
    (directory / "replay.txt").write_text(repeatability + "\n")
    print(f"replay: {repeatability}; not a gameplay oracle")
    if options.expected:
        expected_path = directory / "expected.jsonl"
        shutil.copyfile(options.expected, expected_path)
        for name in ("drive", "replay"):
            with expected_path.open() as expected, (directory / f"{name}-output.jsonl").open() as actual:
                for index, (left, right) in enumerate(zip_longest(expected, actual), 1):
                    require(left is not None and right is not None and json.loads(left) == json.loads(right),
                            f"{name}: expected output differs at record {index}")
        print("verified: complete outputs match supplied expectations")
    if not options.inputs:
        protocol(directory, options)
    print("verified: CLI transport and output envelopes; inspect captured commands for affected behavior")


if __name__ == "__main__":
    main()
