#!/usr/bin/env python3
import hashlib
import json
import os
from pathlib import Path
import select
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parents[4]
TARGET = ROOT / "target" / "verify-game"
ARTIFACTS = ROOT / ".amp/in/artifacts/game-verification"
MAX_RESPONSE_BYTES = 272 * 1024 * 1024
BUTTONS = (
    "move_up", "move_down", "move_left", "move_right",
    "action_up", "action_down", "action_left", "action_right",
    "left_shoulder", "right_shoulder", "back", "start",
)
FRAME = {"canvas": [1280, 720], "clear": [0, 0, 0, 255], "commands": []}


def build(platform):
    subprocess.run([
        "cargo", "build", "--locked", "-p", "platform", "--no-default-features",
        "--features", platform, "--bin", platform, "--target-dir", str(TARGET),
    ], cwd=ROOT, check=True, timeout=600)


def evidence_directory():
    ARTIFACTS.mkdir(parents=True, exist_ok=True)
    return Path(tempfile.mkdtemp(prefix="run-", dir=ARTIFACTS))


def read_line(process, evidence):
    line = bytearray()
    deadline = time.monotonic() + 15
    while len(line) <= MAX_RESPONSE_BYTES:
        remaining = deadline - time.monotonic()
        if remaining <= 0 or not select.select([process.stdout], [], [], remaining)[0]:
            raise RuntimeError("CLI did not flush a response within 15 seconds")
        chunk = os.read(process.stdout.fileno(), min(65536, MAX_RESPONSE_BYTES + 1 - len(line)))
        evidence.write(chunk)
        evidence.flush()
        if not chunk:
            raise RuntimeError("CLI exited before a complete response")
        line.extend(chunk)
        if len(line) > MAX_RESPONSE_BYTES:
            break
        if line.endswith(b"\n"):
            return bytes(line)
    raise RuntimeError("CLI response exceeds 272 MiB")


def session(directory, name, inputs, expected_error=None):
    environment = os.environ.copy()
    environment.pop("DISPLAY", None)
    environment.pop("WAYLAND_DISPLAY", None)
    with (directory / f"{name}-input.jsonl").open("wb") as sent, \
         (directory / f"{name}-output.jsonl").open("wb") as received, \
         (directory / f"{name}-stderr.txt").open("wb") as errors:
        process = subprocess.Popen([str(TARGET / "debug/cli")], cwd=ROOT,
                                   env=environment, stdin=subprocess.PIPE,
                                   stdout=subprocess.PIPE, stderr=errors)
        try:
            startup = read_line(process, received)
            if json.loads(startup) != {"uploads": []}:
                raise RuntimeError("unexpected initialization output")
            print(f"healthy: {name}, initialization received without a display")
            for record in inputs:
                sent.write(record)
                sent.flush()
                process.stdin.write(record)
                process.stdin.flush()
                if not expected_error:
                    frame = read_line(process, received)
                    if json.loads(frame) != FRAME:
                        raise RuntimeError("unexpected frame output")
            if not expected_error:
                process.stdin.close()
            status = process.wait(timeout=15)
            (directory / f"{name}-status.txt").write_text(f"{status}\n")
            remainder = process.stdout.read(1)
            received.write(remainder)
            if remainder:
                raise RuntimeError("unexpected output after the last response")
            if (status != 0) != bool(expected_error):
                raise RuntimeError(f"unexpected exit status: {status}")
        finally:
            if process.poll() is None:
                process.kill()
            process.wait(timeout=5)
            process.stdout.close()
            if not process.stdin.closed:
                process.stdin.close()
    error_text = (directory / f"{name}-stderr.txt").read_text()
    if expected_error:
        if expected_error not in error_text:
            raise RuntimeError(f"missing diagnostic: {expected_error}")
    elif error_text:
        raise RuntimeError(f"unexpected stderr: {error_text}")
    with (directory / f"{name}-output.jsonl").open("rb") as output:
        return hashlib.file_digest(output, "sha256").digest()


def input_frame(controller, secs=0, nanos=16666667):
    return (json.dumps({"dt": {"secs": secs, "nanos": nanos},
                        "controller": controller}, separators=(",", ":")) + "\n").encode()


def drive_cli(directory):
    inputs = [input_frame({})]
    for button in BUTTONS:
        for position, transitions in (("down", 1), ("down", 0), ("up", 1)):
            inputs.append(input_frame({button: {"ended": position, "half_transitions": transitions}}))
    inputs.extend([
        input_frame({"action_left": {"ended": "up", "half_transitions": 8}}, secs=3, nanos=712345678),
        input_frame({}, nanos=0),
        input_frame({}, secs=18446744073709551615, nanos=999999999),
    ])
    first = session(directory, "controls", inputs)
    replay = session(directory, "replay", inputs)
    if first != replay:
        raise RuntimeError("replay output differs")
    session(directory, "invalid", [b"{}\n"], expected_error="missing field")
    request = input_frame({}).rstrip(b"\n")
    at_limit = request + b" " * (16384 - len(request) - 1) + b"\n"
    session(directory, "at-limit", [at_limit])
    session(directory, "oversized", [at_limit[:-1] + b" \n"],
            expected_error="input line exceeds 16384 bytes")
    session(directory, "eof", [])
    print(f"verified: {len(inputs)} controlled frames, identical replay, size boundary, EOF and fail-fast errors")


def linux_drive(directory):
    for command in ("xdotool", "import"):
        if not shutil.which(command):
            raise RuntimeError(f"missing required tool: {command}")
    with (directory / "linux.log").open("wb") as log:
        process = subprocess.Popen([str(TARGET / "debug/linux")], cwd=ROOT, stdout=log, stderr=log)
        try:
            window = None
            for _ in range(200):
                if process.poll() is not None:
                    raise RuntimeError("Linux platform exited before becoming ready")
                result = subprocess.run(["xdotool", "search", "--name", "^gamz$"],
                                        capture_output=True, timeout=2)
                if result.returncode == 0 and "commands=" in (directory / "linux.log").read_text():
                    window = result.stdout.decode().splitlines()[0]
                    break
                time.sleep(0.1)
            if window is None:
                raise RuntimeError("Linux platform did not become ready")
            if "wgpu adapter:" not in (directory / "linux.log").read_text():
                raise RuntimeError("Linux platform did not report an adapter")
            print(f"healthy: Linux window={window}, adapter and frames observed")
            subprocess.run(["xdotool", "windowfocus", window], check=True, timeout=5)
            subprocess.run(["import", "-window", window, str(directory / "linux-before.png")], check=True, timeout=5)
            with (directory / "linux-actions.txt").open("w") as actions:
                for key in ("w", "a", "s", "d", "Up", "Left", "Down", "Right", "q", "e", "space"):
                    actions.write(f"{key}\n")
                    actions.flush()
                    subprocess.run(["xdotool", "key", "--window", window, key], check=True, timeout=5)
                    time.sleep(0.15)
                subprocess.run(["import", "-window", window, str(directory / "linux-after.png")], check=True, timeout=5)
                actions.write("Escape\n")
                actions.flush()
                subprocess.run(["xdotool", "keydown", "--window", window, "Escape"], check=True, timeout=5)
            status = process.wait(timeout=10)
            (directory / "linux-status.txt").write_text(f"{status}\n")
            if status != 0:
                raise RuntimeError(f"unexpected Linux exit status: {status}")
        finally:
            if process.poll() is None:
                process.kill()
            process.wait(timeout=5)
    print("verified: Linux keyboard path, presentation and Escape exit")


def main():
    command = sys.argv[1] if len(sys.argv) == 2 else ""
    if command == "launch":
        build("cli")
        print(f"ready: {TARGET / 'debug/cli'}; each drive owns a fresh process")
    elif command in ("doctor", "drive", "linux"):
        directory = evidence_directory()
        print(f"evidence: {directory}", flush=True)
        if command == "doctor":
            session(directory, "doctor", [])
        elif command == "drive":
            drive_cli(directory)
        else:
            build("linux")
            subprocess.run(["xvfb-run", "-a", "-s", "-screen 0 1280x720x24",
                            sys.executable, str(Path(__file__).resolve()), "_linux", str(directory)],
                           check=True)
    elif len(sys.argv) == 3 and sys.argv[1] == "_linux":
        linux_drive(Path(sys.argv[2]))
    elif command == "cleanup":
        print("clean: every drive tears down its children; evidence is retained")
    else:
        raise SystemExit("usage: verify-game {launch|doctor|drive|linux|cleanup}")


if __name__ == "__main__":
    main()
