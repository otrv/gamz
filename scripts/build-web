#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
profile=release
directory=release
if (( $# == 1 )) && [[ "$1" == --dev ]]; then
    profile=dev
    directory=debug
elif (( $# != 0 )); then
    echo 'usage: ./scripts/build-web [--dev]' >&2
    exit 2
fi

if ! installed=$(wasm-bindgen --version 2>/dev/null) || [[ "$installed" != 'wasm-bindgen 0.2.129' ]]; then
    echo 'wasm-bindgen 0.2.129 is required; run ./scripts/setup' >&2
    exit 1
fi

set -x
cargo build -p platform-web --lib --profile "$profile" --locked --target wasm32-unknown-unknown --target-dir target
mkdir -p target/web/game
wasm-bindgen "target/wasm32-unknown-unknown/$directory/platform_web.wasm" \
    --target web --out-dir target/web/game --out-name game --no-typescript
cp crates/platform-web/index.html target/web/game/index.html
set +x
echo '==> web build: target/web/game/index.html'
